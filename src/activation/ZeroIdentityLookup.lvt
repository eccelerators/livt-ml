namespace Livt.ML.Activation
using Livt.Math.Arithmetic
using Livt.ML.Storage
/** Rounded lookup with a zero lower tail and identity upper tail, e.g. GELU-new. */
component ZeroIdentityLookup<LOW: int, HIGH: int, STEP_BITS: int, CENTER: int, TABLE: ILookupTable>
{
 static assert LOW >= -1073741823 && LOW < 0 && HIGH > 0 && HIGH <= 1073741823, "lookup bounds must straddle zero"
 static assert STEP_BITS >= 0 && STEP_BITS <= 20, "invalid lookup step"
 static assert CENTER >= 0 && CENTER <= 1048576, "invalid lookup center"
 table: TABLE
 math: WideArithmetic<31>
 failed: bool
 new(table: TABLE) { this.table = table
 math = new WideArithmetic<31>() }
 public fn Compute(value: int) int
 {
  failed = false
  if (value <= LOW) { return 0 }
  if (value >= HIGH) { return value }
  var index = (math.DivideEven(value as logic[64], (1 << STEP_BITS) as logic[64]) as int) + CENTER
  if (index < 0 || index >= table.Length()) { failed = true
   return 0 }
  return table.Read(index)
 }
 public fn Failed() bool { return failed }
}
