namespace Livt.ML.Storage
using Livt.IO
using Livt.ML.Numeric
/** Flattened, low-nibble-first INT4 tensors in external 32-bit little-endian storage. */
component QuantizedTensorWeights<BITS: int, FRACTION: int, SCALE_FRACTION: int,
 GROUP_SIZE: int, CATALOG: ITensorCatalog, MEMORY: IRam<int>> : IWeightTensor {
 static assert GROUP_SIZE > 0, "invalid quantization group"
 catalog: CATALOG
 memory: MEMORY
 fixed: FixedPointMath<BITS, FRACTION, SCALE_FRACTION>
 rows: int
 columns: int
 count: int
 codes: int
 scales: int
 failed: bool
 new(catalog: CATALOG, memory: MEMORY) {
  this.catalog = catalog
  this.memory = memory
  fixed = new FixedPointMath<BITS, FRACTION, SCALE_FRACTION>()
 }
 override fn Select(tensor: int) bool {
  count = 0
  rows = 0
  columns = 0
  failed = true
  var r = catalog.Rows(tensor)
  var c = catalog.Columns(tensor)
  if (r <= 0 || c <= 0) { return false }
  if (r > 2147483647 / c) { return false }
  var n = r * c
  var w = catalog.WeightByteAddress(tensor)
  var s = catalog.ScaleWordAddress(tensor)
  var bytes = n / 2 + n % 2
  var groups = (n - 1) / GROUP_SIZE + 1
  if (w < 0 || w > 2147483647 - bytes || s < 0 || s > 2147483647 - groups) { return false }
  if (!memory.IsValidAddress(w / 4) || !memory.IsValidAddress((w + bytes - 1) / 4) ||
      !memory.IsValidAddress(s) || !memory.IsValidAddress(s + groups - 1)) { return false }
  rows = r
  columns = c
  count = n
  codes = w
  scales = s
  failed = false
  return true
 }
 override fn Rows() int { return rows }
 override fn Columns() int { return columns }
 override fn Read(index: int) int {
  if (failed || index < 0 || index >= count) { failed = true
   return 0 }
  var address = codes + index / 2
  var word = memory.Read(address / 4) as logic[32]
  var packed = (word >> ((address % 4) * 8)) as byte
  var code = fixed.SignedNibble(packed, index % 2 != 0)
  var scale = memory.Read(scales + index / GROUP_SIZE) as logic[32]
  var value = fixed.Weight(code, scale)
  failed = fixed.Failed()
  return value
 }
 override fn Failed() bool { return failed }
}
