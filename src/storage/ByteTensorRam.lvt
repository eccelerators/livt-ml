namespace Livt.ML.Storage

using Livt.IO

/**
 * Logical byte tensor backed by one 2,048-byte Livt.IO RAM.
 *
 * `logicalSize` must be in 1..2048. Invalid writes are ignored and invalid
 * reads return zero. Reads inherit Livt.IO.Ram's registered-address timing.
 */
component ByteTensorRam2048
{
	public const CAPACITY: int = 2048
	ram0: Ram
	logicalSize: int

	new(logicalSize: int)
	{
		this.ram0 = new Ram()
		this.logicalSize = logicalSize
	}

	/** Writes one byte and ignores an index outside the logical capacity. */
	public fn Write(index: int, value: byte)
	{
		if (index < 0) { return }
		if (index >= logicalSize) { return }
		if (index >= CAPACITY) { return }
		this.ram0.WriteByte(index, value)
	}

	/** Reads one byte, or zero for an index outside the logical capacity. */
	public fn Read(index: int) byte
	{
		if (index < 0) { return 0x00 }
		if (index >= logicalSize) { return 0x00 }
		if (index >= CAPACITY) { return 0x00 }
		return this.ram0.ReadByte(index)
	}
}

/**
 * Logical byte tensor backed by two banked Livt.IO RAMs.
 *
 * `logicalSize` must be in 1..4096. Invalid writes are ignored and invalid
 * reads return zero. Reads inherit Livt.IO.Ram's registered-address timing.
 */
component ByteTensorRam4096
{
	public const CAPACITY: int = 4096
	ram0: Ram
	ram1: Ram
	logicalSize: int

	new(logicalSize: int)
	{
		this.ram0 = new Ram()
		this.ram1 = new Ram()
		this.logicalSize = logicalSize
	}

	/** Writes one byte and ignores an index outside the logical capacity. */
	public fn Write(index: int, value: byte)
	{
		if (index < 0) { return }
		if (index >= logicalSize) { return }
		if (index >= CAPACITY) { return }
		if (index < 2048) {
			this.ram0.WriteByte(index, value)
		} else {
			this.ram1.WriteByte(index - 2048, value)
		}
	}

	/** Reads one byte, or zero for an index outside the logical capacity. */
	public fn Read(index: int) byte
	{
		if (index < 0) { return 0x00 }
		if (index >= logicalSize) { return 0x00 }
		if (index >= CAPACITY) { return 0x00 }
		if (index < 2048) { return this.ram0.ReadByte(index) }
		return this.ram1.ReadByte(index - 2048)
	}
}

/**
 * Logical byte tensor backed by four banked Livt.IO RAMs.
 *
 * `logicalSize` must be in 1..8192. Invalid writes are ignored and invalid
 * reads return zero. Reads inherit Livt.IO.Ram's registered-address timing.
 */
component ByteTensorRam8192
{
	public const CAPACITY: int = 8192
	ram0: Ram
	ram1: Ram
	ram2: Ram
	ram3: Ram
	logicalSize: int

	new(logicalSize: int)
	{
		this.ram0 = new Ram()
		this.ram1 = new Ram()
		this.ram2 = new Ram()
		this.ram3 = new Ram()
		this.logicalSize = logicalSize
	}

	/** Writes one byte and ignores an index outside the logical capacity. */
	public fn Write(index: int, value: byte)
	{
		if (index < 0) { return }
		if (index >= logicalSize) { return }
		if (index >= CAPACITY) { return }
		if (index < 2048) {
			this.ram0.WriteByte(index, value)
		} else {
			if (index < 4096) {
				this.ram1.WriteByte(index - 2048, value)
			} else {
				if (index < 6144) {
					this.ram2.WriteByte(index - 4096, value)
				} else {
					this.ram3.WriteByte(index - 6144, value)
				}
			}
		}
	}

	/** Reads one byte, or zero for an index outside the logical capacity. */
	public fn Read(index: int) byte
	{
		if (index < 0) { return 0x00 }
		if (index >= logicalSize) { return 0x00 }
		if (index >= CAPACITY) { return 0x00 }
		if (index < 2048) { return this.ram0.ReadByte(index) }
		if (index < 4096) { return this.ram1.ReadByte(index - 2048) }
		if (index < 6144) { return this.ram2.ReadByte(index - 4096) }
		return this.ram3.ReadByte(index - 6144)
	}
}
