namespace Livt.ML.Linear

/**
 * Pipelined 64-output broadcast MAC with eight signed 16x8 multiplier lanes.
 *
 * Each AccumulateRow call captures one activation and one packed row of 64
 * signed-int8 weights. The engine updates eight int32 accumulators per cycle.
 */
component Int8BroadcastMac64x8
{
	request: logic
	primitive: Int8BroadcastMac64x8Primitive

	new() { primitive = new Int8BroadcastMac64x8Primitive() }

	fn Submit(resetValue: logic)
	{
		primitive.clear = resetValue
		request = !request
		primitive.request = request
		while (primitive.acknowledge != request) { state {} }
	}

	/** Clears all 64 int32 output accumulators. */
	public fn Reset()
	{
		Submit(0b1)
	}

	/** Accumulates one activation against a packed row of 64 signed-int8 weights. */
	public fn AccumulateRow(activation: int, weights: logic[512])
	{
		state {
			primitive.activation = activation
			primitive.weights = weights
		}
		Submit(0b0)
	}

	/** Returns one int32 output accumulator, or zero for an invalid index. */
	public fn GetResult(index: int) int
	{
		if (index < 0 || index >= 64) { return 0 }
		primitive.resultIndex = index as logic[6]
		state {}
		return primitive.result
	}
}
