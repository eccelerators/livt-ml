namespace Livt.ML.Linear

/** Portable pipelined eight-lane primitive for a 64-element signed-int8 dot product. */
@Opaque
component Int8Dot64x8Primitive
{
	public request: in logic
	public clear: in logic
	public configure: in logic
	public index: in logic[6]
	public value: in int
	public weights: in logic[512]
	public acknowledge: out logic
	public result: out int
}
