namespace Livt.ML.Linear

using Livt.ML.Numeric
using Livt.ML.Storage

/** RAM-backed non-streaming ONNX per-column QLinearMatMul reference. */
component QLinearMatMul256x10Ram
{
	public const INPUT_SIZE: int = 256
	public const OUTPUT_SIZE: int = 10
	inputValues: ByteTensorRam2048
	weights: ByteTensorRam4096
	multipliers: int[10]
	divisors: int[10]
	inputZeroPoints: int[10]
	weightZeroPoints: int[10]
	outputZeroPoints: int[10]
	accumulators: int[10]
	output: int[10]

	new()
	{
		this.inputValues = new ByteTensorRam2048(INPUT_SIZE)
		this.weights = new ByteTensorRam4096(2560)
	}

	/** Stores one flattened uint8 input value and ignores an invalid index. */
	public fn SetInput(index: int, value: int)
	{
		if (index < 0) { return }
		if (index >= INPUT_SIZE) { return }
		this.inputValues.Write(index, value as byte)
	}

	/** Clears all weights, quantization parameters, accumulators, and outputs. */
	public fn Clear()
	{
		for (var index = 0; index < 2560; index++) { this.weights.Write(index, 0x00) }
		for (var column = 0; column < OUTPUT_SIZE; column++) {
			multipliers[column] = 0
			divisors[column] = 1
			inputZeroPoints[column] = 0
			weightZeroPoints[column] = 0
			outputZeroPoints[column] = 0
			accumulators[column] = 0
			output[column] = 0
		}
	}

	/** Stores one signed-int8 column weight and ignores an invalid index. */
	public fn SetWeight(column: int, row: int, value: int)
	{
		if (column < 0) { return }
		if (column >= OUTPUT_SIZE) { return }
		if (row < 0) { return }
		if (row >= INPUT_SIZE) { return }
		this.weights.Write(column * 256 + row, value as byte)
	}

	/** Stores the rational scale and tensor zero points for one output column. */
	public fn SetColumnParameters(
		column: int, multiplier: int, divisor: int,
		inputZeroPoint: int, weightZeroPoint: int, outputZeroPoint: int)
	{
		if (column < 0) { return }
		if (column >= OUTPUT_SIZE) { return }
		multipliers[column] = multiplier
		divisors[column] = divisor
		inputZeroPoints[column] = inputZeroPoint
		weightZeroPoints[column] = weightZeroPoint
		outputZeroPoints[column] = outputZeroPoint
	}

	/** Computes ten uint8 outputs using ONNX-style centered multiplication. */
	public fn Compute()
	{
		for (var column = 0; column < OUTPUT_SIZE; column++) {
			var accumulator = 0
			for (var row = 0; row < INPUT_SIZE; row++) {
				var activation = (this.inputValues.Read(row) as int) - inputZeroPoints[column]
				var weightBits: logic[8] = this.weights.Read(column * 256 + row)
				var centeredWeight = (weightBits as int) - weightZeroPoints[column]
				accumulator = accumulator + activation * centeredWeight
			}
			accumulators[column] = accumulator
			output[column] = RequantizeUInt8.ApplyRational(
				accumulator, multipliers[column], divisors[column], outputZeroPoints[column])
		}
	}

	/** Returns one int32 accumulator, or zero for an invalid index. */
	public fn GetAccumulator(index: int) int
	{
		if (index < 0) { return 0 }
		if (index >= OUTPUT_SIZE) { return 0 }
		return accumulators[index]
	}

	/** Returns one quantized output, or zero for an invalid index. */
	public fn GetOutput(index: int) int
	{
		if (index < 0) { return 0 }
		if (index >= OUTPUT_SIZE) { return 0 }
		return output[index]
	}
}
