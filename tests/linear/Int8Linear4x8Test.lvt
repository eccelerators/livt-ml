namespace Livt.ML.Tests.Linear

using Livt.ML.Linear

@Test
component Int8Linear4x8Test
{
	layer: Int8Linear4x8

	new()
	{
		layer = new Int8Linear4x8()
	}

	@Test
	fn ComputesSignedWeightsAndBiases()
	{
		layer.ClearParameters()
		layer.SetRowValues(0, 1, -2, 3, -4)
		layer.SetBias(0, 10)

		var input: int[4] = [5, 6, 7, 8]
		layer.Compute(input)

		assert layer.GetAccumulator(0) == -8
		assert layer.GetAccumulator(1) == 0
	}

	@Test
	fn PreservesInt32AccumulatorResults()
	{
		layer.ClearParameters()
		layer.SetRowValues(7, 127, 127, 127, 127)
		layer.SetBias(7, 100000)

		var input: int[4] = [127, 127, 127, 127]
		layer.Compute(input)

		assert layer.GetAccumulator(7) == 164516
	}

	@Test
	fn IgnoresInvalidRowsAndGetters()
	{
		layer.ClearParameters()
		layer.SetRowValues(99, 1, 1, 1, 1)
		layer.SetBias(-1, 5)

		var input: int[4] = [1, 1, 1, 1]
		layer.Compute(input)

		assert layer.GetAccumulator(-1) == 0
		assert layer.GetAccumulator(8) == 0
	}
}
