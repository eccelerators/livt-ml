namespace Livt.ML.Tests.Linear

using Livt.ML.Linear

/**
 * Exercises Int8Mac8 with a shared fixture instance. Each scenario establishes the inputs
 * and state it needs.
 */
@Test
component Int8Mac8Test
{
	/**
	 * Checks that Accumulate s eight signed weights.
	 */
	@Test
	fn AccumulatesEightSignedWeights()
	{
		var result = Int8Mac8.Accumulate(17,
			1, 2, 3, 4, 5, 6, 7, 8,
			0x01, 0xff, 0x02, 0xfe, 0x03, 0xfd, 0x04, 0xfc)
		assert result == 7
	}
}
